# Trip Planning Concierge - Environment Template
# Copy this file to .env and fill in your actual values.
# Authentication uses DefaultAzureCredential - run `az login` locally, no API keys stored here.

# Azure AI Foundry project (provisioned via azd - see README "Azure Deployment")
# Format: https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-project.services.ai.azure.com/api/projects/your-project
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5-mini

# Application Insights connection string - only required when running the hosted Concierge
# (auto-injected by Foundry at deploy time; only set this manually for local hosted testing)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Local-only demo toggle
TRIP_DEMO_DEFAULT_DESTINATION=Tokyo
